# Supabase (Next.js — use these in .env.local and Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser or use NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=

# Optional: if set, POST /api/openai-usage requires X-Ingest-Secret header (Agent 3)
# INGEST_SECRET=

# Deprecated (Vite SPA) — remove after migration is complete
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
